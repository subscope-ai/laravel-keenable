{
    "name": "subscope-ai/laravel-keenable",
    "description": "Laravel client for the Keenable search & fetch API, with tools for Laravel AI agents.",
    "keywords": ["laravel", "keenable", "search", "fetch"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/json-schema": "^12.62|^13.15",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^0.8"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "SubscopeAi\\Keenable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SubscopeAi\\Keenable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SubscopeAi\\Keenable\\KeenableServiceProvider"
            ],
            "aliases": {
                "Keenable": "SubscopeAi\\Keenable\\Facades\\Keenable"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "stable"
}
